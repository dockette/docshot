# No auth, no keys: LAN only — never expose to the internet.

TZ=UTC

DOCSHOT_DEFAULT_DPI=150
# Longest edge of any output image; protects against gigapixel spreadsheet pages.
DOCSHOT_MAX_SIDE=10000
# One container: Go service + Gotenberg (LibreOffice, Chromium).
DOCSHOT_CPUS=4.0
DOCSHOT_MEMORY=4g

# Disk cache of rendered results (mounted as a volume in compose.yml); size takes 10GB, 512MB…
DOCSHOT_CACHE_SIZE=10GB
# Re-check the source after (0 = never, 7d, 12h); purge with DELETE /cache?s3=bucket/key.
DOCSHOT_CACHE_TTL=0
